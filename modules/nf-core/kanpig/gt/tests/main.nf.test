nextflow_process {

    config "./nextflow.config"

    name "Test Process KANPIG_GT"
    script "../main.nf"
    process "KANPIG_GT"

    tag "modules"
    tag "modules_nfcore"
    tag "kanpig"
    tag "kanpig/gt"
    tag "samtools/faidx"

    setup {
        run("SEQKIT_REPLACE") {
            script "../../../seqkit/replace/main.nf"
            process {
                """
                input[0] = [
                    [ id:'no_chr_genome' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]
                input[1] = ''
                """
            }
        }
        run("SAMTOOLS_FAIDX", alias: "SAMTOOLS_FAIDX2") {
            script "../../../samtools/faidx/main.nf"
            process {
                """
                input[0] = SEQKIT_REPLACE.out.fastx
                            .map { meta, fastx -> [ meta, fastx, [] ] }
                input[1] = false
                """
            }
        }
    }

    test("kanpig - gt - vcf") {

        when {
            params {
                module_args2 = "--pattern 'chr' --replacement ''"
            }

            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vcf/ped/justhusky_minimal.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vcf/ped/justhusky_minimal.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/earlycasualcaiman_sorted_md.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/earlycasualcaiman_sorted_md.bam.bai', checkIfExists: true),
                    [],
                    [],
                ]

                input[1] = SEQKIT_REPLACE.out.fastx
                            .join(SAMTOOLS_FAIDX2.out.fai)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.vcf.get(0).get(1)).vcf.summary,
                    path(process.out.vcf.get(0).get(1)).vcf.variantsMD5,
                    process.out.findAll { key, val -> key.startsWith("versions")},
                    ).match() }
            )
        }

    }

    test("kanpig - gt - vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vcf/ped/justhusky_minimal.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/vcf/ped/justhusky_minimal.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/earlycasualcaiman_sorted_md.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/earlycasualcaiman_sorted_md.bam.bai', checkIfExists: true),
                    [],
                    [],
                ]

                input[1] = SEQKIT_REPLACE.out.fastx
                            .join(SAMTOOLS_FAIDX2.out.fai)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
